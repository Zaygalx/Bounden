# Bounden cashier worker — configuration is env-only. Paths, never values:
# key FILES live in the vault (~/workspace/bounden-secrets), this file is
# a template and must never contain a real key.
BOUNDEN_CONTRACT_ACCOUNT_ID=bounden.testnet
BOUNDEN_AGENT_ACCOUNT_ID=cashier.bounden.testnet
BOUNDEN_AGENT_KEY_FILE=/home/you/workspace/bounden-secrets/agent-keys/agent-leashed-ed25519.json
BOUNDEN_VAULT_DIR=/home/you/workspace/bounden-secrets/worker-vault
# (BOUNDEN_VAULT_DIR names the worker-vault directory ITSELF: the
# state file is <BOUNDEN_VAULT_DIR>/vault-state.json. Pointing it at
# the parent secrets directory makes the worker open an empty vault
# and report every product exhausted — measured live, 10 Nov 2026.)
BOUNDEN_VAULT_KEY_FILE=/home/you/workspace/bounden-secrets/worker-vault.key
NEAR_RPC_URL=https://rpc.testnet.near.org
BOUNDEN_POLL_INTERVAL_MS=15000
BOUNDEN_SCAN_LIMIT=10000
# Stage 3 judgement layer (NEAR AI Cloud). Provider selection:
#   null    (default) no judgement layer — Stage 2 behaviour
#   local   dev-only local hash (NOT a TEE attestation)
#   near-ai NEAR AI Cloud TEE judgements + attestation hashes
BOUNDEN_ATTESTATION_PROVIDER=null
# The API key VALUE goes in the process environment / secret store only —
# never in this file once it holds a real key, never in the repo.
NEAR_AI_CLOUD_API_KEY=
NEAR_AI_CLOUD_MODEL=
NEAR_AI_CLOUD_BASE_URL=https://cloud-api.near.ai/v1
