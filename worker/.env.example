# Bounden cashier worker — configuration is env-only. Paths, never values:
# key FILES live in the vault (~/workspace/bounden-secrets), this file is
# a template and must never contain a real key.
BOUNDEN_CONTRACT_ACCOUNT_ID=bounden.testnet
BOUNDEN_AGENT_ACCOUNT_ID=cashier.bounden.testnet
BOUNDEN_AGENT_KEY_FILE=/home/you/workspace/bounden-secrets/agent-keys/agent-leashed-ed25519.json
BOUNDEN_VAULT_DIR=/home/you/workspace/bounden-secrets
# (worker vault state lands in <BOUNDEN_VAULT_DIR>/worker-vault)
BOUNDEN_VAULT_KEY_FILE=/home/you/workspace/bounden-secrets/worker-vault.key
NEAR_RPC_URL=https://rpc.testnet.near.org
BOUNDEN_POLL_INTERVAL_MS=15000
BOUNDEN_SCAN_LIMIT=10000
