# Bounden storefront — copy to .env.local for local live mode, or set the
# same variables in the Vercel project settings. No secrets belong here:
# the storefront only makes public view calls.
#
# Leave BOUNDEN_CONTRACT_ACCOUNT_ID empty to run in FIXTURE MODE
# (clearly-labelled sample data, no chain reads).
BOUNDEN_CONTRACT_ACCOUNT_ID=
# The contract has no list-products view: in live mode the catalogue is
# built by reading each of these product ids with get_product.
BOUNDEN_PRODUCT_IDS=licence-pro,api-credits-10k,asset-pack-starter
# Public key of the cashier's LEASHED access key; the Constitution page
# reads its permission object with view_access_key. Public data.
BOUNDEN_AGENT_PUBLIC_KEY=
NEAR_RPC_URL=https://rpc.testnet.near.org
